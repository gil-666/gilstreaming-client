<!-- This block matches the redistributable used by the upstream packaging scripts. -->
<?define VCREDIST_VER = "14.51.36247.0" ?>
<?define VCREDIST_X64_SIZE = "18731856" ?>
<?define VCREDIST_X64_SHA512 = "C42C82CFD5EAA2165B600F6109CB14FF4308CDF4CFF656A1375B4A933F1630BFE54C99C4D0FB9ED3BEA4DC4E4FDAA3DB8E7C58356CCA07C2954F4C297757D62D" ?>
<?define VCREDIST_X64_URL = "https://download.visualstudio.microsoft.com/download/pr/ebdab8e5-1d7b-4d9f-a11b-cbb1720c3b12/843068991DAAA1F73AD9F6239BCE4D0F6A07A51F18C37EA2A867E9BECA71295C/VC_redist.x64.exe" ?>
<?define VCREDIST_X64_UPGRADE_CODE = "36F68A90-239C-34DF-B58C-64B30153CE35" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle Name="GilStreaming"
          Version="!(bind.PackageVersion.GilStreaming_x64)"
          Manufacturer="GilServers"
          UpgradeCode="89888225-652E-4B66-9505-F5D799C386C3"
          HelpUrl="https://github.com/gil-666/gilstreaming-client"
          UpdateUrl="https://github.com/gil-666/gilstreaming-client/releases"
          DisableModify="yes"
          IconSourceFile="..\..\app\gilstreaming.ico">

    <bal:Condition Message="GilStreaming requires Windows 10 or later." Condition="VersionNT &gt;= v10.0" />
    <bal:Condition Message="GilStreaming requires a 64-bit version of Windows." Condition="VersionNT64" />

    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles6432Folder]GilStreaming" />
    <Variable Name="AddDesktopShortcutCheckbox" Type="numeric" Value="1" />
    <util:RegistrySearch Variable="HasDesktopShortcutInstallStateRegKey" Root="HKCU" Key="Software\GilStreaming" Value="DesktopShortcutInstallState" Result="exists" />
    <util:RegistrySearch Variable="AddDesktopShortcutCheckbox" Root="HKCU" Key="Software\GilStreaming" Value="DesktopShortcutInstallState" Condition="HasDesktopShortcutInstallStateRegKey" />

    <util:ProductSearch Id="VCREDIST_14_x64"
                        UpgradeCode="$(var.VCREDIST_X64_UPGRADE_CODE)"
                        Result="version"
                        Variable="VCREDIST_14_x64" />

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication ShowVersion="yes"
                                              LicenseFile="..\MoonlightSetup\license.rtf"
                                              LogoFile="..\..\app\res\gilstreaming-logo.png"
                                              LaunchTarget="[InstallFolder]\GilStreaming.exe"
                                              ThemeFile="..\MoonlightSetup\RtfTheme.xml"
                                              Theme="rtfLicense" />
      <Payload Name="GilStreaming.ico" SourceFile="..\..\app\gilstreaming.ico" Compressed="yes" />
    </BootstrapperApplication>

    <Chain>
      <ExePackage Cache="remove"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  DetectCondition="VCREDIST_14_x64 &gt;= v$(var.VCREDIST_VER)"
                  InstallArguments="/install /quiet /norestart">
        <ExePackagePayload Description="Microsoft Visual C++ 2015-2022 Redistributable - x64"
                           ProductName="Microsoft Visual C++ 2015-2022 Redistributable - x64"
                           Size="$(var.VCREDIST_X64_SIZE)"
                           Version="$(var.VCREDIST_VER)"
                           Hash="$(var.VCREDIST_X64_SHA512)"
                           Name="VC_redist.x64.exe"
                           DownloadUrl="$(var.VCREDIST_X64_URL)" />
        <ExitCode Value="1638" Behavior="success" />
      </ExePackage>

      <MsiPackage Id="GilStreaming_x64"
                  SourceFile="$(env.BUILD_ROOT)\build-x64-$(env.BUILD_CONFIG)\Moonlight.msi"
                  Name="GilStreaming_x64.msi"
                  Vital="yes">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="ADDDESKTOPSHORTCUT" Value="[AddDesktopShortcutCheckbox]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
